# SovereignAI Workbench Environment Configuration
APP_NAME="SovereignAI Workbench"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="air-gapped"

# Network & Host
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Local Inference Daemon
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_GENERAL_MODEL="qwen3:8b"
DEFAULT_VISION_MODEL="qwen2.5-vl:7b"
DEFAULT_CODING_MODEL="qwen2.5-coder:7b"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
VRAM_BUDGET_MB=16384

# Security & Sandboxing
STRICT_AIR_GAP_ENFORCEMENT=true
ALLOW_EXTERNAL_CALLS=false
SANDBOX_ENABLED=true
SANDBOX_DOCKER_IMAGE="sovereign-sandbox:latest"
SANDBOX_TIMEOUT_SECONDS=30
